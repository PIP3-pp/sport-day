# All variables below are SERVER-ONLY. Nothing here is exposed to the browser
# (no NEXT_PUBLIC_ variables are needed).

# Prisma Postgres connection string (console.prisma.io or Vercel Marketplace)
DATABASE_URL=

# Better Auth — generate the secret with: npx @better-auth/cli secret
BETTER_AUTH_SECRET=
# Site origin: http://localhost:3000 locally, your domain in production
BETTER_AUTH_URL=http://localhost:3000

# Vercel Blob token, needed only for logo / highlight image uploads
BLOB_READ_WRITE_TOKEN=

# Used once by `npm run admin:create` to create the administrator account
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

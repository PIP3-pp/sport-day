# All variables below are SERVER-ONLY. Nothing here is exposed to the browser
# (no NEXT_PUBLIC_ variables are needed).

# Local Docker database (npm run db:up). Production's Prisma Postgres URL goes
# in .env.production-db, used only by the *:prod scripts (see README).
DATABASE_URL=postgres://postgres:postgres@localhost:5433/sportday_dev
# Emptied by every `npm run test:db` run; its name must contain "test".
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5433/sportday_test

# Better Auth — generate the secret with: npx @better-auth/cli secret
BETTER_AUTH_SECRET=
# Site origin: http://localhost:3000 locally, your domain in production
BETTER_AUTH_URL=http://localhost:3000

# Vercel Blob token, needed only for logo / highlight image uploads
BLOB_READ_WRITE_TOKEN=

# Used once by `npm run admin:create` to create the administrator account
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin
